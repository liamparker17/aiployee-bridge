{
  "name": "aiployee-bridge-installer",
  "productName": "AIployee Bridge Installer",
  "version": "0.1.9",
  "description": "Self-contained desktop GUI that installs the aiployee-bridge MCP server into Claude Desktop. Bundles the bridge runtime; no Node.js or git required on the user's machine.",
  "private": true,
  "author": "Liam Parker",
  "repository": {
    "type": "git",
    "url": "https://github.com/liamparker17/aiployee-bridge.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/prepare-bridge-bundle.js",
    "build": "electron-builder",
    "build:win": "node scripts/prepare-bridge-bundle.js && electron-builder --win",
    "build:mac": "node scripts/prepare-bridge-bundle.js && electron-builder --mac",
    "build:linux": "node scripts/prepare-bridge-bundle.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.liamparker.aiployee-bridge-installer",
    "productName": "AIployee Bridge Installer",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bundled-bridge",
        "to": "bridge",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
